{
 "id": "b2-106-irregular-plurals",
 "level": "B2",
 "subject": 106,
 "title": "Irregular Plurals",
 "description": "Plurals that do not simply add -s.",
 "items": [
  {
   "kind": "flashcard",
   "word": "-al → -aux",
   "type": "Rule",
   "translation": "Most nouns in -al take -aux; bal, carnaval, festival, récital take -s",
   "exampleFr": "Un cheval, des chevaux ; un festival, des festivals.",
   "exampleEn": "A horse, horses; a festival, festivals.",
   "id": "001"
  },
  {
   "kind": "flashcard",
   "word": "-eau, -au, -eu → -x",
   "type": "Rule",
   "translation": "Add -x; pneu and bleu take -s",
   "exampleFr": "Un bateau, des bateaux ; un pneu, des pneus.",
   "exampleEn": "A boat, boats; a tyre, tyres.",
   "id": "002"
  },
  {
   "kind": "flashcard",
   "word": "-ou → -s (sauf sept)",
   "type": "Rule",
   "translation": "Add -s, except bijou, caillou, chou, genou, hibou, joujou, pou, which take -x",
   "exampleFr": "Un trou, des trous ; un bijou, des bijoux.",
   "exampleEn": "A hole, holes; a jewel, jewels.",
   "id": "003"
  },
  {
   "kind": "flashcard",
   "word": "-ail → -s (sauf quelques-uns)",
   "type": "Rule",
   "translation": "Add -s, except travail, vitrail, corail, émail → -aux",
   "exampleFr": "Un détail, des détails ; un travail, des travaux.",
   "exampleEn": "A detail, details; a job, works.",
   "id": "004"
  },
  {
   "kind": "flashcard",
   "word": "-s, -x, -z",
   "type": "Rule",
   "translation": "No change in the plural",
   "exampleFr": "Un prix, des prix ; un nez, des nez.",
   "exampleEn": "A price, prices; a nose, noses.",
   "id": "005"
  },
