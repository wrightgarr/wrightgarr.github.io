  {
   "kind": "flashcard",
   "word": "L'impératif",
   "type": "Rule",
   "translation": "Three forms only (tu, nous, vous), with no subject pronoun",
   "exampleFr": "Regarde ! Regardons ! Regardez !",
   "exampleEn": "Look! Let's look! Look!",
   "id": "001"
  },
  {
   "kind": "flashcard",
   "word": "Tu : pas de -s pour les verbes en -er",
   "type": "Rule",
   "translation": "-er verbs (and aller) drop the -s of the tu form",
   "exampleFr": "Tu parles → Parle ! Tu vas → Va !",
   "exampleEn": "You speak → Speak! You go → Go!",
   "id": "002"
  },
  {
   "kind": "flashcard",
   "word": "Impératif négatif",
   "type": "Rule",
   "translation": "ne + verb + pas",
   "exampleFr": "Ne parle pas ! Ne mangez pas ça !",
   "exampleEn": "Don't speak! Don't eat that!",
   "id": "003"
  },
  {
   "kind": "flashcard",
   "word": "Verbes pronominaux à l'impératif",
   "type": "Rule",
   "translation": "The pronoun follows with a hyphen (te → toi); in the negative it goes back in front",
   "exampleFr": "Lève-toi ! Ne te lève pas !",
   "exampleEn": "Get up! Don't get up!",
   "id": "004"
  },
