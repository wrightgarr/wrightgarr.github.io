  {
   "kind": "flashcard",
   "word": "é — accent aigu",
   "type": "Accent",
   "translation": "Closed “ay” sound, as in “café”",
   "exampleFr": "L'été, je vais au café.",
   "exampleEn": "In summer, I go to the café.",
   "id": "001"
  },
  {
   "kind": "flashcard",
   "word": "è — accent grave",
   "type": "Accent",
   "translation": "Open “eh” sound, as in English “bed”",
   "exampleFr": "Mon père et ma mère sont ici.",
   "exampleEn": "My father and my mother are here.",
   "id": "002"
  },
  {
   "kind": "flashcard",
   "word": "ê — accent circonflexe",
   "type": "Accent",
   "translation": "Open “eh” sound; often marks an old lost “s”",
   "exampleFr": "La forêt est belle.",
   "exampleEn": "The forest is beautiful.",
   "hint": "forêt ↔ forest, hôpital ↔ hospital",
   "id": "003"
  },
  {
   "kind": "flashcard",
   "word": "ë — tréma",
   "type": "Accent",
   "translation": "Pronounce this vowel separately from the one before it",
   "exampleFr": "Joyeux Noël !",
   "exampleEn": "Merry Christmas!",
   "id": "004"
  },
  {
   "kind": "flashcard",
   "word": "à, ù — accent grave",
   "type": "Accent",
   "translation": "No change in sound; it tells two words apart (a / à, ou / où)",
   "exampleFr": "Il a un ami à Paris.",
   "exampleEn": "He has a friend in Paris.",
   "id": "005"
  },
  {
   "kind": "flashcard",
   "word": "ï — tréma",
   "type": "Accent",
   "translation": "The i is pronounced on its own: ma-ïs",
   "exampleFr": "J'aime le maïs.",
   "exampleEn": "I like corn.",
   "id": "006"
  },
  {
   "kind": "flashcard",
   "word": "â, î, ô, û — accent circonflexe",
   "type": "Accent",
   "translation": "Mostly a spelling mark; ô is a closed “oh”",
   "exampleFr": "L'hôtel est sur une île.",
   "exampleEn": "The hotel is on an island.",
   "id": "007"
  },
